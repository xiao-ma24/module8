# ---------------------------------------------------------------------------
# module8 环境变量模板
# 复制为 .env 后填写：cp deploy/env.example .env
# .env 已被 .gitignore 忽略，不要提交真实口令
# ---------------------------------------------------------------------------

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://127.0.0.1:3306/material_mgmt?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USER=root
DB_PASSWORD=请填写数据库口令

# ---------- 服务端口 ----------
PORT_00=8080
PORT_01=8081
PORT_02=8082
PORT_03=8083
PORT_04=8084
PORT_05=8085

# ---------- 统一登录 ----------
# true：只认统一身份，未登录 401、越权 403
AUTH_ENFORCE=true
# 认证服务地址（供本地网关使用）
AUTH_SERVICE_URL=http://127.0.0.1:18080
# 内部核验密钥，必须与认证服务一致；只放在服务端
AUTH_INTERNAL_SECRET=请填写与认证服务一致的密钥

# ---------- 跨域 ----------
# 同源反向代理部署时可保持默认；直连前端端口时需要把来源写进来
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---------- 可选：AI 助手 ----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=15000

# ---------- 日志 ----------
LOG_LEVEL=info
