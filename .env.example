# ============================================================
# DBA 部署环境变量模板（按《SpringBoot 云数据库接入教程》约定）
# 用法：
#   cp .env.example .env
#   vim .env          # 填 DB_URL / DB_USER / DB_PASSWORD
#   bash scripts/start-all.sh
# .env 不入库，启动脚本自动加载
# ============================================================

# ---------- 数据库 ----------
# 方式一（教程约定，推荐）：完整 JDBC URL（含 & 必须用单引号包起来）
DB_URL='jdbc:mysql://rm-2ze6142myj0uq4u4b4o.mysql.rds.aliyuncs.com:3306/material_mgmt?allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false'
DB_USER=请填写DBA分配的账号
DB_PASSWORD=请填写DBA分配的密码

# 方式二（等价写法，二者取其一）：分开配置
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=material_mgmt
# DB_USER=root
# DB_PASS=请填写数据库口令

# ---------- 服务端口（start-all.sh 读取；不填则用各模块默认 8080~8085） ----------
PORT_00=8080
PORT_01=8081
PORT_02=8082
PORT_03=8083
PORT_04=8084
PORT_05=8085

# ---------- 跨服务地址（部署在同一台机器时可保持默认） ----------
PURCHASE_SERVICE_URL=http://127.0.0.1:8082
BASE_SERVICE_URL=http://127.0.0.1:8081
HTTP_CONNECT_TIMEOUT_MS=3000
HTTP_READ_TIMEOUT_MS=5000

# ---------- AI 助手（可选，不填则使用内置规则引擎） ----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT=15000

# ---------- 统一认证（接入 DBA 统一登录时按 DBA 规范填写） ----------
# 统一鉴权开关：true=未登录 401、角色不符 403（DBA 环境开启）；false=保留各组演示登录
AUTH_ENFORCE=false
AUTH_COOKIE_NAME=DBA_TOKEN
AUTH_USER_HEADER=X-DBA-USER-ID
AUTH_ROLE_HEADER=X-DBA-ROLE
AUTH_BUSINESS_HEADER=X-DBA-BUSINESS-ID
AUTH_TOKEN_EXPIRE_MINUTES=480

# ---------- 跨域 ----------
# 浏览器发出的 POST 会带 Origin 头，即使经过同源反向代理，后端仍会做 CORS 校验，
# 因此必须把「浏览器实际访问的站点来源」写进来（含端口），否则登录会返回 403 Invalid CORS request。
# 本机演练可用 http://localhost:*,http://127.0.0.1:*；生产请改成实际域名，例如
#   CORS_ALLOWED_ORIGINS=https://material.example.com:5173,https://material.example.com:5182,...
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---------- 日志级别 ----------
LOG_LEVEL=info
